# ── Aplicação ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_VERSION=1.0.0
LOG_LEVEL=debug
TZ=America/Sao_Paulo

# ── Banco (docker-compose.yml: host 1434 -> container 1433, ver nota no compose) ─
DATABASE_URL="sqlserver://localhost:1434;database=abertura_processos;user=sa;password=Dev@Str0ngPass!;encrypt=true;trustServerCertificate=true"

# ── JWT ─────────────────────────────────────────────────────
# gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-de-48-bytes-gerado-localmente
JWT_ACCESS_TTL=15m
JWT_ISSUER=abertura-processos
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── CORS (docs/06: nunca "*" com credentials: true) ──────────
# Em produção, mesma origem do front (docs/11) — lista explícita mesmo assim.
CORS_ORIGINS=http://localhost:5173

# ── Login social (docs/06, seção "Login social") ─────────────
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
# Credenciais opcionais: provedor sem credencial fica desabilitado, sem
# impedir a subida da API (GET /auth/providers informa qual está ativo).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/microsoft/callback

# ── Redis (docker-compose.yml: host 6380 -> container 6379, ver nota no compose) ─
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
# Isolamento num Redis compartilhado com outras aplicações (docs/10): DB
# lógico (0-15) e prefixo das chaves do BullMQ. Produtor e worker usam o mesmo.
REDIS_DB=0
REDIS_KEY_PREFIX=ap

# ── SMTP (Mailpit local) ────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Abertura de Processos <nao-responda@opusce.com.br>"

# ── Seed ────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@opusce.com.br
ADMIN_SEED_PASSWORD=Admin@Local123
INTERNAL_ORG_NAME=Opusce
INTERNAL_EMAIL_DOMAIN=opusce.com.br
SEED_DEMO=true

# ── Armazenamento de anexos (docs/10, RF-40 a RF-44, RNF-11) ─
STORAGE_ROOT=./storage/uploads
MAX_UPLOAD_SIZE_MB=100
MAX_FILES_PER_REQUEST=10

# ── Rate limiting (docs/06, tabela de limites) ──────────────
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_MINUTES=15
RATE_LIMIT_OAUTH_CALLBACK_MAX=30
RATE_LIMIT_OAUTH_CALLBACK_WINDOW_MINUTES=15
RATE_LIMIT_CLIENT_MAX=120
RATE_LIMIT_CLIENT_WINDOW_MINUTES=1
RATE_LIMIT_INTERNAL_MAX=1000
RATE_LIMIT_INTERNAL_WINDOW_MINUTES=1
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_UPLOAD_WINDOW_MINUTES=10
RATE_LIMIT_ANONYMOUS_MAX=60
RATE_LIMIT_ANONYMOUS_WINDOW_MINUTES=1
# Falhas de chave de API (401) por IP em /intake (docs/14). Folgado de
# propósito: o IP de saída da nuvem da Anthropic é compartilhado.
RATE_LIMIT_API_KEY_FAILURE_MAX=50
RATE_LIMIT_API_KEY_FAILURE_WINDOW_MINUTES=5

# ── Consulta de CNPJ na Receita (docs/05, "Empresas / CNPJs") ─
# Autopreenchimento de razão social / nome fantasia no cadastro de empresa.
# Desligue com false para exigir preenchimento manual (a rota passa a
# responder 503 CNPJ_LOOKUP_DISABLED; o cadastro manual segue funcionando).
CNPJ_LOOKUP_ENABLED=true
CNPJ_LOOKUP_BASE_URL=https://receitaws.com.br/v1
# Vazio = plano gratuito da ReceitaWS: 3 consultas por minuto por IP.
CNPJ_LOOKUP_TOKEN=
CNPJ_LOOKUP_TIMEOUT_MS=10000
# Cache em memória por CNPJ, em minutos. Protege a cota do plano gratuito.
CNPJ_LOOKUP_CACHE_TTL_MINUTES=60

# ── Intake por e-mail: anexos via Microsoft Graph (docs/13, decisão 3) ─
# Credenciais de APLICAÇÃO (client credentials) do registro no Entra ID,
# com permissão Mail.Read de aplicação restrita à caixa por
# ApplicationAccessPolicy. NÃO são as credenciais do login social
# (MICROSOFT_CLIENT_ID), que é um app delegado.
# Desligado: `fetchAttachments: true` responde 503 MAIL_ATTACHMENTS_DISABLED
# e o intake continua aceitando arquivos por multipart.
GRAPH_INTAKE_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# UPN da caixa lida pelo agente — a MESMA que o conector do claude.ai lê
# (o id de mensagem do Graph é por caixa; docs/14)
GRAPH_MAILBOX=opusoperacional@opusce.com.br
GRAPH_TIMEOUT_MS=30000
# Copiar (nunca mover) o e-mail processado para "<pasta>/<Organização>" na
# mesma caixa (docs/13, decisão 12). Exige o papel Exchange
# "Application Mail.ReadWrite" (com Mail.Read a cópia falha e só gera aviso).
GRAPH_ORGANIZE_ENABLED=false
GRAPH_ORGANIZE_FOLDER=Processos IA
