{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "BFF do sistema de abertura de processos de comércio exterior",
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/http/server.js",
    "lint": "eslint src tests prisma --ext .ts",
    "lint:fix": "eslint src tests prisma --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:deploy:test": "dotenv -e .env.test -- prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "bullmq": "6.0.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.2.0",
    "nodemailer": "9.0.5",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "passport-microsoft": "2.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "4.8.3",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/passport": "1.0.17",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-microsoft": "2.1.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "1.9.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
